{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "green", "blue", "purple"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "faint": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.500",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.500"
        }
      },
      "formfield": {
        "base": "$hue.neutral.100",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.yellow.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.cyan.200" }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.800",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.200" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#4A4540" },
    "scrollbar": { "base": "#6B655E" },
    "diff": {
      "text": {
        "added": "#9AD8A8",
        "removed": "#F2A89B",
        "context": "#B8B0A7",
        "hunkHeader": "#B8B0A7"
      },
      "background": {
        "added": "#1E3A2E",
        "removed": "#4A2320",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "#7FB685",
        "removed": "#E06C5B"
      },
      "lineNumber": {
        "text": "#8A837B",
        "background": {
          "added": "#223026",
          "removed": "#3A2320"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.accent.200",
      "function": "$hue.blue.200",
      "variable": "$hue.red.200",
      "string": "$hue.green.200",
      "number": "$hue.yellow.200",
      "type": "#E8C07A",
      "operator": "$hue.cyan.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.accent.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.cyan.200",
      "code": "$hue.green.200",
      "blockQuote": "#E8C07A",
      "emphasis": "#E8C07A",
      "strong": "$hue.yellow.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.interactive.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#EDE9E3",
        "200": "#D5CFC6",
        "300": "#B8B0A7",
        "400": "#8A837B",
        "500": "#6B655E",
        "600": "#4A4540",
        "700": "#3A352F",
        "800": "#262320",
        "900": "#1E1C1A"
      },
      "red": {
        "100": "#FEDAD4",
        "200": "#F2A89B",
        "300": "#E07868",
        "400": "#C96452",
        "500": "#A94E3E",
        "600": "#863B2E",
        "700": "#5F2A20",
        "800": "#3D1A13",
        "900": "#22100C"
      },
      "orange": {
        "100": "#FFD9C7",
        "200": "#F5B79E",
        "300": "#E99A7A",
        "400": "#D97757",
        "500": "#C96442",
        "600": "#A94E32",
        "700": "#863B26",
        "800": "#5F2A1D",
        "900": "#3A1A13"
      },
      "yellow": {
        "100": "#FDEBC8",
        "200": "#EFC88A",
        "300": "#D9A25B",
        "400": "#B98543",
        "500": "#96682F",
        "600": "#775122",
        "700": "#593B17",
        "800": "#3B250D",
        "900": "#1F1206"
      },
      "green": {
        "100": "#D6F2DC",
        "200": "#9AD8A8",
        "300": "#7FB685",
        "400": "#63996F",
        "500": "#4A7D58",
        "600": "#356143",
        "700": "#25482F",
        "800": "#16301D",
        "900": "#0B1A10"
      },
      "cyan": {
        "100": "#D2EEEA",
        "200": "#9AD1C7",
        "300": "#7FBFB5",
        "400": "#63A199",
        "500": "#4C847D",
        "600": "#376861",
        "700": "#274945",
        "800": "#182E2C",
        "900": "#0C1817"
      },
      "blue": {
        "100": "#D4E6F5",
        "200": "#9ABDDD",
        "300": "#7AA8C7",
        "400": "#5E8DAD",
        "500": "#4A7190",
        "600": "#375573",
        "700": "#274057",
        "800": "#1A2B3B",
        "900": "#0D1620"
      },
      "purple": {
        "100": "#E4DBFB",
        "200": "#BFA9E4",
        "300": "#A68BC7",
        "400": "#8A6FA8",
        "500": "#6F588A",
        "600": "#57446D",
        "700": "#413252",
        "800": "#2B2137",
        "900": "#17111F"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.orange",
      "neutral": "$hue.gray"
    }
  }
}
